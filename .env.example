# ---------------------------------------------------------------------------
# Template. Copy to .env.local and fill in — do NOT put real values here:
#
#   cp .env.example .env.local
#
# .env.local holds secrets and is gitignored. .env holds only non-secret
# defaults. Next.js load order (first match wins):
#   process.env  >  .env.$NODE_ENV.local  >  .env.local  >  .env
#
# In production do not ship either file — set these in your host's secret
# manager (Vercel/Netlify project settings, Docker secrets, etc.), which
# arrives as process.env and outranks both.
# ---------------------------------------------------------------------------

# --- Secrets: .env.local ---------------------------------------------------

# PostgreSQL. DATABASE_URL is the POOLED endpoint; DIRECT_URL is unpooled and
# used for migrations (they cannot run through a transaction pooler).
# Locally both may point at the same server.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/quantumui"
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/quantumui"

# NextAuth v5 reads AUTH_SECRET (NEXTAUTH_SECRET is the v4 name, still accepted).
# Generate one with:  npx auth secret     — or:  openssl rand -base64 32
AUTH_SECRET=

# Google OAuth — "Sign in with Google".
# Google Cloud Console → APIs & Services → Credentials
#   → Create credentials → OAuth client ID → Web application
# Authorised redirect URI must match EXACTLY, including the /api/auth prefix:
#   http://localhost:3000/api/auth/callback/google      (local dev)
#   https://YOUR-DOMAIN/api/auth/callback/google        (production)
# Leave blank to disable Google sign-in; the password form keeps working.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Sessions & rate limiting.
REDIS_URL="redis://localhost:6379"

# Optional external APIs — blank is fine.
QPIAI_API_KEY=
QISKIT_API_KEY=
IBM_QUANTUM_API_KEY=
ARXIV_API_KEY=

# --- Non-secret defaults: .env ---------------------------------------------

# Canonical public origin. SET THIS IN PRODUCTION.
#
# Everything SEO reads it: <link rel="canonical">, Open Graph URLs, the
# generated OG image, robots.txt and sitemap.xml. It must be the origin you
# actually want indexed — with the scheme, no trailing slash.
#
# robots.txt and sitemap.xml are generated at BUILD time, so this has to be
# present when `next build` runs, not just at runtime.
#
# Left unset the app falls back to VERCEL_PROJECT_PRODUCTION_URL (the stable
# production host, not the per-deployment preview URL), then to localhost. That
# fallback is fine for development; in production an unset value means every
# canonical URL and every entry in your sitemap points at the wrong host.
NEXT_PUBLIC_SITE_URL="https://your-domain.example"

# QpiAI Quantum Executor (local Python service)
QUANTUM_EXECUTOR_URL="http://localhost:8080"

# Legacy Qiskit Sandbox API
QISKIT_SANDBOX_URL="http://localhost:8000"

# Security
RATE_LIMIT_MAX_REQUESTS="100" # per minute per user
ENABLE_SANDBOX="true"

# Environment
NODE_ENV="development"

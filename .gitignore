# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the key-name template is documentation and must be committed.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.github-token

# python (quantum-executor service)
quantum-executor/venv/
__pycache__/

# QpiAI cloud credentials — never commit
qcloud.env
quantum-executor/qcloud.env

# Vendored QWorld content is committed (see content/qworld/SOURCES.md);
# only the notebook checkpoint noise is ignored.
.ipynb_checkpoints/
.playwright-mcp/
